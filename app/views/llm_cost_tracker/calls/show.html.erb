<% token_usage = LlmCostTracker::TokenUsage.from_hash(@call.attributes) %>
<% cost = @call.total_cost.nil? ? nil : LlmCostTracker::Cost.from_hash(@call.attributes) %>
<% token_segments = [
  { label: "Input", value: token_usage.input_tokens, formatted_value: format_tokens(token_usage.input_tokens), css_class: "lct-stack-fill-input" },
  { label: "Cache read", value: token_usage.cache_read_input_tokens, formatted_value: format_tokens(token_usage.cache_read_input_tokens), css_class: "lct-stack-fill-cache-read" },
  { label: "Cache write", value: token_usage.standard_cache_write_input_tokens, formatted_value: format_tokens(token_usage.standard_cache_write_input_tokens), css_class: "lct-stack-fill-cache-write" },
  { label: "1h cache write", value: token_usage.cache_write_1h_input_tokens, formatted_value: format_tokens(token_usage.cache_write_1h_input_tokens), css_class: "lct-stack-fill-cache-write-1h" },
  { label: "Output", value: token_usage.output_tokens, formatted_value: format_tokens(token_usage.output_tokens), css_class: "lct-stack-fill-output" }
] %>
<% cost_segments = cost ? [
  { label: "Input", value: cost.input_cost, formatted_value: optional_money(cost.input_cost), css_class: "lct-stack-fill-input" },
  { label: "Cache read", value: cost.cache_read_input_cost, formatted_value: optional_money(cost.cache_read_input_cost), css_class: "lct-stack-fill-cache-read" },
  { label: "Cache write", value: cost.cache_write_input_cost, formatted_value: optional_money(cost.cache_write_input_cost), css_class: "lct-stack-fill-cache-write" },
  { label: "1h cache write", value: cost.cache_write_1h_input_cost, formatted_value: optional_money(cost.cache_write_1h_input_cost), css_class: "lct-stack-fill-cache-write-1h" },
  { label: "Output", value: cost.output_cost, formatted_value: optional_money(cost.output_cost), css_class: "lct-stack-fill-output" }
] : [] %>

<section class="lct-panel">
  <p class="lct-muted"><%= link_to "Back to calls", calls_path %></p>
  <div class="lct-call-hero">
    <div>
      <h2 class="lct-section-title lct-call-title">Call #<%= @call.id %></h2>
      <p class="lct-call-subtitle">
        <code class="lct-code"><%= @call.provider %></code>
        <span>·</span>
        <code class="lct-code"><%= @call.model %></code>
        <span>·</span>
        <span><%= format_date(@call.tracked_at) %></span>
      </p>
    </div>

    <div class="lct-call-summary">
      <div class="lct-call-summary-item">
        <span class="lct-call-summary-label">Pricing</span>
        <strong><%= pricing_status(@call) %></strong>
      </div>
      <div class="lct-call-summary-item">
        <span class="lct-call-summary-label">Total cost</span>
        <strong><%= optional_money(@call.total_cost) %></strong>
      </div>
      <div class="lct-call-summary-item">
        <span class="lct-call-summary-label">Total tokens</span>
        <strong><%= format_tokens(@call.total_tokens) %></strong>
      </div>
      <% if @latency_available %>
        <div class="lct-call-summary-item">
          <span class="lct-call-summary-label">Latency</span>
          <strong><%= @call.latency_ms ? "#{optional_number(@call.latency_ms)}ms" : "n/a" %></strong>
        </div>
      <% end %>
    </div>
  </div>

  <div class="lct-call-breakdown-grid">
    <section class="lct-call-breakdown">
      <h3 class="lct-call-breakdown-title">Token Mix</h3>
      <%= render "llm_cost_tracker/shared/metric_stack", segments: token_segments, empty_message: "No token data for this call." %>
    </section>

    <section class="lct-call-breakdown">
      <h3 class="lct-call-breakdown-title">Cost Mix</h3>
      <% if @call.total_cost.nil? %>
        <p class="lct-call-breakdown-empty">Pricing not available for this call.</p>
      <% else %>
        <%= render "llm_cost_tracker/shared/metric_stack", segments: cost_segments, empty_message: "No cost breakdown for this call." %>
      <% end %>
    </section>
  </div>

  <div class="lct-detail-grid">
    <dl class="lct-dl">
      <dt>Tracked At</dt>
      <dd><%= format_date(@call.tracked_at) %></dd>

      <dt>Provider</dt>
      <dd><%= @call.provider %></dd>

      <dt>Model</dt>
      <dd><%= @call.model %></dd>

      <dt>Pricing Status</dt>
      <dd><%= pricing_status(@call) %></dd>

      <% if LlmCostTracker::LlmApiCall.provider_response_id_column? %>
        <dt>Provider Response ID</dt>
        <dd><%= @call.provider_response_id.presence || "n/a" %></dd>
      <% end %>

      <% if @call.has_attribute?("created_at") %>
        <dt>Created At</dt>
        <dd><%= format_date(@call.created_at) %></dd>
      <% end %>

      <% if @call.has_attribute?("updated_at") %>
        <dt>Updated At</dt>
        <dd><%= format_date(@call.updated_at) %></dd>
      <% end %>
    </dl>

    <dl class="lct-dl">
      <dt>Input Tokens</dt>
      <dd><%= format_tokens(@call.input_tokens) %></dd>

      <% if LlmCostTracker::LlmApiCall.token_usage_columns? %>
        <dt>Cache Read Tokens</dt>
        <dd><%= format_tokens(token_usage.cache_read_input_tokens) %></dd>

        <dt>Cache Write Tokens</dt>
        <dd><%= format_tokens(token_usage.standard_cache_write_input_tokens) %></dd>

        <dt>1h Cache Write Tokens</dt>
        <dd><%= format_tokens(token_usage.cache_write_1h_input_tokens) %></dd>
      <% end %>

      <dt>Output Tokens</dt>
      <dd><%= format_tokens(@call.output_tokens) %></dd>

      <dt>Total Tokens</dt>
      <dd><%= format_tokens(@call.total_tokens) %></dd>

      <dt>Input Cost</dt>
      <dd><%= optional_money(@call.input_cost) %></dd>

      <% if LlmCostTracker::LlmApiCall.token_usage_cost_columns? %>
        <dt>Cache Read Cost</dt>
        <dd><%= optional_money(cost&.cache_read_input_cost) %></dd>

        <dt>Cache Write Cost</dt>
        <dd><%= optional_money(cost&.cache_write_input_cost) %></dd>

        <dt>1h Cache Write Cost</dt>
        <dd><%= optional_money(cost&.cache_write_1h_input_cost) %></dd>
      <% end %>

      <dt>Output Cost</dt>
      <dd><%= optional_money(@call.output_cost) %></dd>

      <dt>Total Cost</dt>
      <dd><%= optional_money(@call.total_cost) %></dd>

      <% if @latency_available %>
        <dt>Latency</dt>
        <dd><%= @call.latency_ms ? "#{optional_number(@call.latency_ms)}ms" : "n/a" %></dd>
      <% end %>
    </dl>
  </div>
</section>

<section class="lct-panel">
  <h2 class="lct-section-title">Tags</h2>
  <pre class="lct-pre"><%= safe_json(@call.parsed_tags) %></pre>
</section>

<% if @call.has_attribute?("metadata") %>
  <section class="lct-panel">
    <h2 class="lct-section-title">Metadata</h2>
    <pre class="lct-pre"><%= safe_json(@call.read_attribute("metadata")) %></pre>
  </section>
<% end %>
